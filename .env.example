# ---- Server ----
NODE_ENV=development
PORT=3000

# ---- Stripe (server-side only) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=shaheer-subscribtion-test

# ---- Application URLs (used as Checkout success/cancel targets) ----
APP_SUCCESS_URL=http://localhost:3000/success
APP_CANCEL_URL=http://localhost:3000/cancel

# ---- Keycloak auth (protects GET /subscriptions/entitlement) ----
# Local dev: AUTH_DISABLED=true (no Keycloak running).
# Production: set AUTH_DISABLED=false + real Keycloak URL/realm/client.
AUTH_DISABLED=true
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=traderverse
KEYCLOAK_CLIENT_ID=traderverse-backend

# ---- Email provider (sendgrid | mailgun | none) ----
# "none" disables real sending and logs emails to the console.
EMAIL_PROVIDER=none
EMAIL_FROM=Traderverse <no-reply@example.com>
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional provider-specific from-address (falls back to EMAIL_FROM).
MAILGUN_FROM=
